name: Build PS3 PKG
on:
  push:
    branches: [ main ]
  workflow_dispatch:
jobs:
  smoke:
    runs-on: ubuntu-latest
    container: ps3dev/ps3dev:latest
    env:
      PS3DEV: /usr/local/ps3dev
      PSL1GHT: /usr/local/ps3dev
    steps:
      - uses: actions/checkout@v4
      - run: make -f Makefile.ps3 PS3_NETLOG_IP="${{ vars.NETLOG_IP || '192.168.0.10' }}" smoke
      - run: make -f Makefile.ps3 smoke.pkg
      - uses: actions/upload-artifact@v4
        with:
          name: sm64coopdx-ps3-smoke
          path: |
            *.pkg
            *.self
            *.elf
