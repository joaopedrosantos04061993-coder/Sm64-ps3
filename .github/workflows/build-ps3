name: Build PS3 PKG
on:
  push:
    branches: [ main ]
  workflow_dispatch:
jobs:
  smoke:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Extrair zip
        run: unzip -q sm64coopdx-ps3.zip
      - name: Compilar no container ps3dev
        run: |
          docker run --rm -v "$PWD/sm64coopdx-ps3:/work" -w /work \
            -e PS3DEV=/usr/local/ps3dev -e PSL1GHT=/usr/local/ps3dev \
            ps3dev/ps3dev:latest \
            sh -c 'make -f Makefile.ps3 PS3_NETLOG_IP=192.168.0.10 smoke && make -f Makefile.ps3 smoke.pkg'
      - uses: actions/upload-artifact@v4
        with:
          name: sm64coopdx-ps3-smoke
          path: |
            sm64coopdx-ps3/*.pkg
            sm64coopdx-ps3/*.self
            sm64coopdx-ps3/*.elf
